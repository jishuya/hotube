PORT=3000

PGHOST=localhost
PGPORT=5434
PGDATABASE=hotube
PGUSER=
PGPASSWORD=

# Child profile photos (leading ~ is expanded to the server user's home directory)
CHILD_PROFILE_UPLOAD_DIR=~/workspace/lab/hotube_data/profile

# Optional pool tuning
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=5000
